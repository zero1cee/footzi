# Footzi Server Environment Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/footzi

# Authentication
JWT_SECRET=footzi_super_secret_jwt_key_development_only_change_in_prod
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Cloudinary Image Management
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# CORS: comma-separated browser origins allowed to call the API.
# Not needed when the server serves the built client itself (the Render setup).
CORS_ORIGIN=http://localhost:5173

# Seeding (optional): private password for admin@footzi.in instead of the public demo one
# SEED_ADMIN_PASSWORD=

# In production (NODE_ENV=production) the server refuses to start unless MONGODB_URI is
# set and JWT_SECRET is a unique random string of at least 32 characters.
