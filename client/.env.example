# Footzi Client Environment Configuration
# Add these in your Render Environment Variables for production (https://footzi.in)

# 1. Razorpay Live Key ID (e.g. rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_live_placeholder_key

# 2. Meta Pixel ID for Instagram & Facebook Ads Tracking (e.g. 123456789012345)
# Obtain from Meta Events Manager -> Datasets / Pixel
VITE_META_PIXEL_ID=

# 3. Google Analytics 4 / Google Tag for Search & Shopping Ads (e.g. G-XXXXXXXXXX)
# Obtain from Google Analytics Admin -> Data Streams
VITE_GA4_MEASUREMENT_ID=

# 4. Production Canonical URL
VITE_SITE_URL=https://footzi.in
